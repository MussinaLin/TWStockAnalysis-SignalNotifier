# PostgreSQL 連線字串（必填）
# 與 AccountService、TWStockAPI 共用同一個 DB；本機開發指向 DEV DB，PROD 用 Railway 的變數。
# 需要的表：users（AccountService）、user_stock_signals / user_config（TWStockAPI）、
# stock_daily_*（TWStockAnalysis）、user_signal_notifications（本 repo db/schema.sql）。
DATABASE_URL=postgresql://user:password@host:port/dbname

# 發送使用者通知的 Telegram bot token（必填）
# 必須與同環境 AccountService 的 TELEGRAM_USER_BOT_TOKEN 是同一個 bot：
# 使用者是對這個 bot 按 Start 完成綁定的，換成別的 bot 會發不出去（403）。
# dev 與 production 各用一個 bot。
TELEGRAM_USER_BOT_TOKEN=123456789:your-user-bot-token

# 網站網址（必填），用來組訊息最後一行的個股連結 <SITE_BASE_URL>/app/<代號>
# DEV：https://dev.darvishkzone.com，PROD：https://darvishkzone.com（結尾的 / 會自動去掉）
SITE_BASE_URL=https://your-site.example.com

# 管理者 bot token（選填；與 TELEGRAM_CHAT_ID 兩個都設定才會發送）
# 每次執行後發摘要「自訂訊號 MM/DD：成功 N 則、失敗 M 則、解除綁定 K 人」，
# 指標尚未算完時發告警。可沿用 AccountService 新使用者通知的那個 bot。
TELEGRAM_BOT_TOKEN=123456789:your-admin-bot-token

# 接收摘要與告警的 chat id（選填），通常是 group，為負數（如 -100...）
TELEGRAM_CHAT_ID=-1001234567890
